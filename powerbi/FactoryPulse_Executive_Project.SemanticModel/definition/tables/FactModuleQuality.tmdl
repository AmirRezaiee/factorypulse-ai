table FactModuleQuality
	lineageTag: 868426d3-9d85-4d5f-95eb-c8a4922d534e

	measure 'Repair Modules' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(FactModuleQuality[module_id]),
			    FactModuleQuality[has_repair] = TRUE()
			)
			
			```
		formatString: 0
		lineageTag: db8a5c77-7d7c-406e-89f3-6a158ffd3654

	measure 'Repair Rate %' = ```
			
			DIVIDE(
			    [Repair Modules],
			    DISTINCTCOUNT(FactModuleQuality[module_id]),
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 90b442d1-5015-49e7-a480-7f6c266ad3ed

