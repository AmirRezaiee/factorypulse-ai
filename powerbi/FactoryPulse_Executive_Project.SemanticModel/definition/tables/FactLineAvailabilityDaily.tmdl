table FactLineAvailabilityDaily
	lineageTag: a3be9e96-3ef0-4864-89da-41ecdc853b98

	measure 'Planned Downtime (Hours)' = ```
			
			DIVIDE(
			    SUM(FactLineAvailabilityDaily[planned_stop_min]),
			    60,
			    0
			)
			
			```
		formatString: 0.00
		lineageTag: 2327311e-b216-4068-b775-0acdc08edd08

	measure 'Unplanned Downtime (Hours)' = ```
			
			DIVIDE(
			    SUM(FactLineAvailabilityDaily[unplanned_stop_min]),
			    60,
			    0
			)
			
			```
		formatString: 0.00
		lineageTag: f0a7769c-e4be-454f-9a2d-9f70470a4371

	measure 'Line Availability %' = ```
			
			DIVIDE(
			    SUM(FactLineAvailabilityDaily[available_min]),
			    SUM(FactLineAvailabilityDaily[calendar_min]),
			    0
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 92dda74a-ac7f-4800-a4e6-46974b4c42d5

