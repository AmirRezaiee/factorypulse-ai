table FactModuleProduction
	lineageTag: 987124a4-8ba5-4a72-8141-3739381b86dc

	measure 'Packed Modules' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(FactModuleProduction[module_id]),
			    FactModuleProduction[packing_completed] = TRUE()
			)
			
			```
		formatString: 0
		lineageTag: b12fffd5-20ee-4980-9e4f-6bba649124e2

	measure 'Packed Modules (Full Days)' =
			VAR CurrentDay = SELECTEDVALUE(DimDate[date])
			RETURN
			    IF(
			        CurrentDay IN { DATE(2026, 7, 1), DATE(2026, 9, 29) },
			        BLANK(),
			        [Packed Modules]
			    )
		formatString: 0

